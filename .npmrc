# .npmrc — viavitae-demos
#
# Configures the @via-vitae npm scope to resolve from GitHub Packages.
# The NODE_AUTH_TOKEN is provided by CI (GitHub Actions) or by the developer's
# local environment. Never commit a token value here.
#
# GitHub Packages registry for @via-vitae scope
@via-vitae:registry=https://npm.pkg.github.com/

# Use npm token for authentication (set NODE_AUTH_TOKEN in environment or CI secret)
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# viavitae-demos .gitignore
# Node + pnpm + Next.js monorepo. Every repository generated from viavitae-template
# starts with the superset and trims what does not apply.
#
# Never un-ignore a secret, key, state file or environment file. If a value must be
# committed, it is not a secret and belongs in documentation or a schema.

# --- Secrets and credentials -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
.secrets.baseline

# --- Node and frontend -------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.npm/
.pnp.*
*.tsbuildinfo
.eslintcache
.stylelintcache
.parcel-cache/
.vite/

# --- pnpm --------------------------------------------------------------------
# pnpm-lock.yaml IS committed (reproducible builds). pnpm-debug logs are not.
pnpm-debug.log*

# --- Build artefacts ---------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Test and tooling output -------------------------------------------------
playwright-report/
test-results/
coverage/
coverage.xml
*.lcov
junit.xml

# --- Python (tools and scripts only) -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editors and IDEs --------------------------------------------------------
.idea/*
!.idea/runConfigurations/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Operating systems -------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Media cache (generated from seed during provisioning) -------------------
.cache/
media-cache/

# --- Archives and large binaries ---------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.dmg
*.iso

# --- Terraform and infrastructure state (provisioning scripts) ---------------
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars

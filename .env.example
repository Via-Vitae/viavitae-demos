# ── viavitae-demos environment ──────────────────────────────────────
# Copy to .env.local and fill in values.
# NEVER commit .env.local — only .env.example is tracked.

# API endpoint (use api-mock for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo base URL
DEMO_BASE_URL=http://localhost:3000

# Stripe TEST mode keys ONLY — live keys are NEVER permitted
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key-starts-with-pk_test_>
STRIPE_SECRET_KEY=<stripe-secret-key-starts-with-sk_test_>

# Tile server URL (for cemetery-services GPS map)
NEXT_PUBLIC_TILESERVER_URL=http://localhost:8080

# Tile server API token (if required)
TILESERVER_API_TOKEN=

# Assessment funnel URL
NEXT_PUBLIC_ASSESSMENT_URL=https://viavitae.com/assessment

# Cal.com booking URL
NEXT_PUBLIC_BOOKING_URL=https://cal.com/viavitae/assessment

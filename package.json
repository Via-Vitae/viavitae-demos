{
  "name": "viavitae-demos",
  "version": "0.1.0",
  "private": true,
  "description": "ViaVitae demo templates — sandboxed live demos for the sales channel.",
  "license": "UNLICENSED",
  "author": "ViaVitae IT Technologies",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "verify:seed-hashes": "tsx reset/seed-hash.ts --verify",
    "verify:media-licences": "bash scripts/verify-media-licences.sh",
    "reset": "./reset/reset.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@via-vitae/eslint-config": "workspace:*",
    "@via-vitae/prettier-config": "workspace:*",
    "@via-vitae/tsconfig": "workspace:*",
    "eslint": "^9.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@via-vitae/brand": "workspace:*",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.0"
  }
}
